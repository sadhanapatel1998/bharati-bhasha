# MongoDB connection string. If unset, admin APIs (categories, exams,
# economic-survey, etc.) and admin login fall back to demo/mock data automatically.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/bharati-bhasha

# Used only by `npm run seed:admin` to create the first admin user in the DB.
SEED_ADMIN_EMAIL=admin@bharatibhasha.org
SEED_ADMIN_PASSWORD=admin123
SEED_ADMIN_NAME=Admin Name
